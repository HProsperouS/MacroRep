# Base URL for the FastAPI backend. Leave empty to use the Vite dev proxy (/api).
VITE_API_BASE_URL=

# Where the Vite dev server proxies /api during local development.
VITE_DEV_PROXY_TARGET=http://127.0.0.1:8000

# Answer API calls with the in-memory mock (src/api/mock). Defaults to true in dev.
# Set to false once the FastAPI backend is running.
VITE_USE_MOCK_API=true

# Never put secrets (OpenAI keys, DB credentials) in frontend env vars —
# everything prefixed VITE_ is shipped to the browser.
