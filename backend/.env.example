APP_ENV=local
APP_NAME=MacroRep API
API_PREFIX=/api/v1
DATABASE_URL=postgresql+psycopg://macrorep:local-development-only@localhost:5432/macrorep
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]
LOG_LEVEL=INFO
LOG_JSON=false
# Also keep logs in daily files under backend/logs: app-<date>.log (everything) and
# error-<date>.log (errors only, with tracebacks), each kept for 14 days.
# Leave LOG_DIR empty for console only. Tests never write log files.
LOG_DIR=logs
PREVIEW_AUTH_ENABLED=true
AUTO_CREATE_SCHEMA=false
SEED_DEMO_DATA=true

# Signs the access tokens this backend issues itself (see app/auth). The
# local default is rejected once APP_ENV=prod, where this must be a private,
# randomly generated value.
JWT_SECRET_KEY=
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=30

# The refresh token rides in an httpOnly cookie scoped to the auth routes.
# SameSite=strict is the CSRF defence; only a frontend served from a different
# origin needs `none` there, and that also requires SECURE=true (which the
# production validator enforces regardless). Leave DOMAIN unset to bind the
# cookie to whichever host set it.
REFRESH_COOKIE_NAME=macrorep_refresh
REFRESH_COOKIE_PATH=/api/v1/auth
REFRESH_COOKIE_SECURE=false
REFRESH_COOKIE_SAMESITE=strict

# Language model behind the weekly check-in agents: "fake" (rule-based, no API key) or
# "openai", which needs OPENAI_API_KEY. Tests and CI always use "fake".
COACH_MODEL_PROVIDER=fake
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.4-mini
